# deploy/versions.env —— 机器可读版本钉死（env-up.sh / CI 唯一 source 的版本来源）。
# 人类可读文档与钉死纪律见 deploy/versions.md（单一事实源）；本文件是它的机器可读形式，两者必须同步。
# 纪律：改版本 = 单独 PR；禁跟踪 main/HEAD；新增组件须过"HCS 私域演示可离线安装"评审。
# 形态：KEY=value，可被 bash `source`。chart 版本与应用版本分列，helm 安装用 chart 版本。

# --- 本地/CI 集群工具链 ---
AEGIS_KIND_VERSION=v0.24.0
AEGIS_KUBECTL_VERSION=v1.37.1
AEGIS_HELM_VERSION=v3.22.0

# --- kind 集群节点镜像（kindest/node，与 kind 版本兼容矩阵核验）---
# 注：docker.io 本网络不可达，经 docker.m.daocloud.io 拉取后本地 retag（make up 前脚本自动处理）。
# 实机核验 digest=sha256:25a3504b2b34...(v1.31.0，daocloud 镜像源）。
AEGIS_KIND_NODE_IMAGE=kindest/node:v1.31.0

# --- 组件（helm chart 版本钉死；app 版本随 chart）---
# chart 源（本网络实测：*.github.io Pages 被墙；prometheus/argo 走 ghcr OCI 已核验可达，
# chaos-mesh 未发布到 ghcr、用其官方 repo（可达））：
AEGIS_CHAOS_MESH_CHART=chaos-mesh/chaos-mesh
AEGIS_PROMETHEUS_CHART=oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack
AEGIS_ARGO_CD_CHART=oci://ghcr.io/argoproj/argo-helm/argo-cd
# Chaos Mesh —— 故障注入（M1 验收 / M3 场景库 T3.2）
AEGIS_CHAOS_MESH_CHART_VERSION=2.7.2
# Prometheus + Grafana —— kube-prometheus-stack（闸门核心看板，deploy/observability §4.3）
AEGIS_KUBE_PROMETHEUS_STACK_CHART_VERSION=65.5.0
# ArgoCD —— R2 强制 PR 通道（ADR-001，T2.10）
AEGIS_ARGO_CD_CHART_VERSION=7.6.12
# kagent —— Agent 运行时 L3（ADR-002；oci://ghcr.io/kagent-dev/kagent/helm/{kagent-crds,kagent} 已核验）
AEGIS_KAGENT_CHART_VERSION=0.10.3
AEGIS_KAGENT_CRDS_CHART=oci://ghcr.io/kagent-dev/kagent/helm/kagent-crds
AEGIS_KAGENT_CHART=oci://ghcr.io/kagent-dev/kagent/helm/kagent

# --- 组件镜像仓库镜像源（deploy/kind/README.md §4.3；空 = 直连默认源）---
# China 私域/网络受限环境注入镜像加速；CI 不假设代理可达。
AEGIS_REGISTRY_MIRROR_DOCKER_IO=${AEGIS_REGISTRY_MIRROR_DOCKER_IO:-https://docker.m.daocloud.io}
