# deploy/observability/.env.example —— Langfuse 自托管密钥模板（示例值）。
# 用法：cp .env.example .env 后填真实值。.env 已在根 .gitignore（.env / .env.*）排除，严禁入库。
# 纪律（§4.1）：接入三要素只经环境变量注入，不进 git。

# --- Langfuse 核心 ---
LANGFUSE_SECRET_KEY=sk-lf-change-me
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SALT=change-me-long-random-salt
# 初始管理员（首次启动建号用）。
LANGFUSE_INIT_USER_EMAIL=admin@aegis.local
LANGFUSE_INIT_USER_PASSWORD=change-me-strong-password
LANGFUSE_INIT_USER_NAME=aegis-admin

# --- 数据面组件口令 ---
POSTGRES_PASSWORD=change-me-postgres
CLICKHOUSE_PASSWORD=change-me-clickhouse
MINIO_ROOT_PASSWORD=change-me-minio

# --- OTel collector → Langfuse 的 Basic Auth ---
# 取值 = base64("${LANGFUSE_PUBLIC_KEY}:${LANGFUSE_SECRET_KEY}")
# 生成：printf '%s' "pk-lf-...:sk-lf-..." | base64
LANGFUSE_OTEL_BASIC_AUTH=change-me-base64-of-pk-colon-sk
